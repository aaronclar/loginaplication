<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro</title>
</head>
<body>
  <h1>Crear cuenta</h1>
  <form action="/register" method="POST">
    <label>Usuario:</label>
    <input type="text" name="username" required /><br />
    <label>Contraseña:</label>
    <input type="password" name="password" required /><br />
    <button type="submit">Registrarse</button>
  </form>
</body>
</html>